{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=claim_bridge;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "ClaimBridge",
    "Audience": "ClaimBridgeClient",
    "Key": "REPLACE_WITH_USER_SECRET_MINIMUM_32_CHARACTERS",
